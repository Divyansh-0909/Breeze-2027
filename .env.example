# ---------------------------------------------------------------------------
# Example environment variables for Breeze-2027
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database (Prisma / Postgres) ---
# Pooled connection string used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?pgbouncer=true"
# Direct (non-pooled) connection string used for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# --- Supabase ---
# Public — exposed to the browser
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Secret — server-side only, full admin access. Keep private.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Email / SMTP (payment + admin confirmation flows) ---
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USERNAME="your-smtp-username"
EMAIL_PASSWORD="your-smtp-password"
EMAIL_FROM="noreply@example.com"
EMAIL_FROM_NAME="Breeze"

# --- App ---
# Base URL of the app (e.g. http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL is the pooled connection (port 6543, pgbouncer).
  // This is required for Supabase serverless environments (Next.js Edge/Serverless)
  // because each function invocation opens a connection. Pooling prevents connection exhaustion.
  url       = env("DATABASE_URL")
  
  // DIRECT_URL is the direct connection (port 5432).
  // Prisma's migration engine (prisma migrate / prisma db push) requires a persistent, 
  // non-pooled connection to the database to track locks and apply schema changes safely.
  directUrl = env("DIRECT_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EventItem {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  event_name          String           @default("")
  event_description   String           @default("")
  event_price         Int              @db.SmallInt
  event_org           String?
  event_venue         String?
  event_date          String?
  image_url           String?
  event_type          event_category?
  registration_open   Boolean          @default(true)
  event_end_date      String?          // End date for multi-day events (null = single day)
  event_pair_price    Int?             @db.SmallInt  // Price for pair tickets (null = no pair pricing)
  ConfirmedEvent      ConfirmedEvent[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model MerchItem {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  product_name        String
  product_price       Int              @default(0) @db.SmallInt
  product_description String           @default("")
  image_url           String?
  ConfirmedMerch      ConfirmedMerch[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PendingTransaction {
  id                  String                 @id
  amount              BigInt
  time                DateTime               @default(now()) @db.Timestamptz(6)
  cart                Json
  accommodation       accommodation_option[]
  accommodation_price BigInt
  paymentReference    String? @unique
  paymentAccountId    String?
  paymentUpiId        String?
  paymentPayeeName    String?
  pricingSnapshot     Json?
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model SubmittedTransaction {
  token               String                 @id @db.VarChar
  created_at          DateTime               @default(now()) @db.Timestamptz(6)
  name                String                 @default("")
  email               String                 @default("")
  phone               String                 @default("")
  address             String                 @default("")
  amount              BigInt                 @default(0)
  proof               String?                @default("")
  cart                Json
  approved            Boolean?               @default(false)
  rejected            Boolean                @default(false)
  rejection_reason    String?
  email_sent          Boolean                @default(false)
  accommodation       accommodation_option[]
  accommodation_price BigInt
  student_details     String?
  ConfirmedEvent      ConfirmedEvent[]
  ConfirmedMerch      ConfirmedMerch[]
  paymentReference    String? @unique
  paymentAccountId    String?
  paymentAccount      PaymentAccount? @relation(fields: [paymentAccountId], references: [id])
  paymentUpiId        String?
  paymentPayeeName    String?
  pricingSnapshot     Json?
  claimedBankReference String?
  bankReference       String?
  paymentStatus       String @default("AWAITING_STATEMENT")
  paymentReportedAt   DateTime?
  paymentReviewReason String?
  matchedCreditId     String? @unique
  matchedCredit       BankCredit? @relation(fields: [matchedCreditId], references: [id])
  paymentAudits       PaymentAudit[]
  paymentEmails       PaymentEmail[]

  @@index([paymentAccountId, approved, rejected])
}

model PaymentAccount {
  id                    String @id @default(cuid())
  label                 String
  bankName              String
  accountLast4          String
  upiId                 String
  payeeName             String
  active                Boolean @default(false)
  noteMatchingVerified  Boolean @default(false)
  noteVerifiedBy        String?
  noteVerifiedAt        DateTime?
  createdAt             DateTime @default(now())
  createdBy             String
  transactions          SubmittedTransaction[]
  statements            BankStatement[]
  credits               BankCredit[]
}

model BankStatement {
  id              String @id @default(cuid())
  accountId       String
  account         PaymentAccount @relation(fields: [accountId], references: [id])
  fileHash        String
  filename        String
  format          String
  extractedRows   Json
  sourceText      String
  reviewed        Boolean @default(false)
  importedAt      DateTime @default(now())
  importedBy      String
  credits         BankCredit[]

  @@unique([accountId, fileHash])
}

model BankCredit {
  id              String @id @default(cuid())
  accountId       String
  account         PaymentAccount @relation(fields: [accountId], references: [id])
  statementId     String
  statement       BankStatement @relation(fields: [statementId], references: [id])
  identity        String
  rowHash         String
  bookedAt        DateTime
  amountPaise     BigInt
  direction       String
  bankReference   String?
  description     String
  orderReferences String[]
  conflict        Boolean @default(false)
  matchedOrder    SubmittedTransaction?

  @@unique([accountId, identity])
  @@index([accountId, bankReference])
}

model PaymentAudit {
  id           String @id @default(cuid())
  token        String
  transaction  SubmittedTransaction @relation(fields: [token], references: [token])
  action       String
  actor        String
  details      Json
  createdAt    DateTime @default(now())
}

model PaymentEmail {
  id          String @id @default(cuid())
  token       String
  transaction SubmittedTransaction @relation(fields: [token], references: [token])
  kind        String
  status      String @default("PENDING")
  attempts    Int @default(0)
  lastError   String?
  updatedAt   DateTime @updatedAt

  @@unique([token, kind])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ConfirmedEvent {
  token                String               @db.VarChar
  id                   String               @db.Uuid
  quantity             BigInt               @default(0)
  EventItem            EventItem            @relation(fields: [id], references: [id], onDelete: Cascade, map: "confirmedEvent_id_fkey")
  SubmittedTransaction SubmittedTransaction @relation(fields: [token], references: [token], onDelete: Cascade, map: "confirmedEvent_token_fkey")

  @@id([token, id], map: "confirmedEvent_pkey")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ConfirmedMerch {
  token                String               @db.VarChar
  id                   String               @db.Uuid
  size                 String               @default("")
  quantity             BigInt               @default(0)
  MerchItem            MerchItem            @relation(fields: [id], references: [id], onDelete: Cascade, map: "confirmedMerch_id_fkey")
  SubmittedTransaction SubmittedTransaction @relation(fields: [token], references: [token], onDelete: Cascade, map: "confirmedMerch_token_fkey")

  @@id([token, id, size])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Roles {
  id        String @id(map: "roles_pkey") @db.Uuid
  club_name String @default("")
  email     String @default("")
}

/// This enum is commented in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
enum event_category {
  Cultural
  Technical
}

/// This enum is commented in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
enum accommodation_option {
  DAY1
  DAY2
  DAY3
}

/// Contact form submissions from the Get In Touch page
model ContactSubmission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String
  email      String
  phone      String
  message    String
}
